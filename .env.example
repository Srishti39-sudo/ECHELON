# Copy to .env and fill in. .env is gitignored; never commit real keys.
# Only the provider you actually use needs a key.

# Gemini, the default provider. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq, the fallback if a Gemini safety filter trips on ordnance content.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# NVIDIA-hosted models (Nemotron and others). Free key: https://build.nvidia.com
NVIDIA_API_KEY=

# Default provider for this project: gemini | groq | nvidia
DEEPECHO_PROVIDER=gemini

# --- Docker (docs/DOCKER.md). None of this is needed outside compose. --------

# serve: no torch, the default. full: adds the detector, tile upload and survey
# processing, and wants 2 GB of memory for the hazard container.
# DEEPECHO_PROFILE=full

# Make plain `docker compose up` mean the live-reload setup. Use ; on Windows.
# COMPOSE_FILE=compose.yaml:compose.dev.yaml

# The API address the BROWSER uses. Only when the gateway is not on
# localhost:8000; the dashboard image must be rebuilt after changing it.
# VITE_API_BASE_URL=http://localhost:8000
